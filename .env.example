# 复制成 .env 后按需修改。环境变量的优先级高于代码里的默认值。
#
# ⚠️ 注意：HF_ENDPOINT / HF_HOME / NO_PROXY 这几个**不能**写在这里。
#    它们必须在任何 HuggingFace 模块被导入之前就存在于 os.environ 中，
#    而 .env 是在 app.config 被导入时才读的，太晚了。
#    那几个变量统一在 app/__init__.py 里用 os.environ.setdefault 设置。

# ---------- LLM ----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2

# ---------- 向量模型 ----------
# BAAI/bge-small-zh-v1.5   24M 参数 /  512 维 -> 西游记全书约 3 分钟   ← 推荐
# BAAI/bge-large-zh-v1.5  326M 参数 / 1024 维 -> 效果更好，但约 1.5~3 小时
MODEL_NAME=BAAI/bge-small-zh-v1.5
DEVICE=cpu

# ---------- 切分与检索 ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=80
BATCH_SIZE=32
TOP_K=5

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=50
